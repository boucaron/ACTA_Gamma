CC      ?= cc
CFLAGS  ?= -Wall -Wextra -std=c11 -O2 -g
LDLIBS ?= -lsqlite3

# ---- cJSON (override CJSON_DIR / CJSON_LIB to point at a custom build) ----
CJSON_DIR ?=
CJSON_LIB ?= -lcjson
ifneq ($(CJSON_DIR),)
CFLAGS += -I$(CJSON_DIR)
endif
LDLIBS += $(CJSON_LIB)

INC_DIR  := include
SRC_DIR  := src
OBJ_DIR  := build/obj
TEST_DIR := tests
TEST_BIN_DIR := test

# ─── Generated schema header (embedded by acta_cli) ─────────────────────────────
# Single source of truth: schema.sql. The CLI embeds it as one C string literal
# (include/schema_sql.h) for `db init`; regenerated here so a changed schema
# propagates to the CLI build. The GUI regenerates its Qt resource from the
# same file (acta_gui/assets.qrc). The schema contains no double-quote or
# backslash characters, so each line is emitted as a quoted literal ending in
# an escaped newline with no other escaping.
SCHEMA_H := $(INC_DIR)/schema_sql.h

# ─── Generated migrations header (embedded by acta_cli) ───────────────────
# Single source of truth: acta_db/migrations/<version>.sql (repo-static,
# one static-DDL file per schema version). `db migrate` embeds the whole
# migration table as C string literals (include/migrations_sql.h), the
# same generation rule as schema_sql.h. Filenames are dotted versions
# ("0.1.sql"); the integer PRAGMA user_version is the filename minus the
# "0." prefix (0.1 -> 1). The migrations contain no double-quote or
# backslash characters, so each line is emitted as a quoted literal
# ending in an escaped newline with no other escaping.
MIGRATIONS_H := $(INC_DIR)/migrations_sql.h
MIGRATIONS := $(sort $(wildcard migrations/*.sql))

# First target in the file is $(SCHEMA_H); make the library build the default.
.DEFAULT_GOAL := all

$(MIGRATIONS_H): $(MIGRATIONS)
	@{ echo '/* GENERATED FILE - do not edit by hand. Source of truth:'; echo ' * acta_db/migrations/ (one static-DDL file per schema version, embedded by `db migrate`).'; echo ' * Regenerated by the acta_db Makefile rule (migrations_sql.h, from the'; echo ' * migrations/ 0.*.sql files). Each migration is one C string literal:'; echo ' * each line is a quoted literal ending in an escaped newline. The'; echo ' * migrations contain no double-quote or backslash characters, so no'; echo ' * other escaping is needed.'; echo ' */'; echo ''; echo '#ifndef ACTA_MIGRATIONS_SQL_H'; echo '#define ACTA_MIGRATIONS_SQL_H'; echo ''; echo '/* One repo-static schema migration per version, ascending order.'; echo ' * version = the PRAGMA user_version integer (0.1 -> 1, 0.2 -> 2, ...);'; echo ' * the {0, NULL} row terminates the table.'; echo ' */'; echo 'typedef struct { int version; const char *sql; } acta_migration_t;'; echo ''; echo 'static const acta_migration_t ACTA_MIGRATIONS[] = {'; for f in $(MIGRATIONS); do v=$$(basename $$f .sql); iv=$${v#0.}; printf '    { %s, ' "$$iv"; awk '{ print "\"" $$0 "\\" "n\"" }' $$f; printf ' },\n'; done; echo '    { 0, NULL }'; echo '};'; echo ''; echo '#endif /* ACTA_MIGRATIONS_SQL_H */'; } > include/migrations_sql.h.tmp && mv include/migrations_sql.h.tmp include/migrations_sql.h || rm -f include/migrations_sql.h.tmp

$(SCHEMA_H): schema.sql
	@{ echo '/* GENERATED FILE - do not edit by hand. Source of truth: acta_db/schema.sql.'; echo ' * Regenerated by the acta_db Makefile rule (schema_sql.h: schema.sql).'; echo ' * Embedded as one C string literal: each line is a quoted literal ending in an'; echo ' * escaped newline. The schema contains no double-quote or backslash'; echo ' * characters, so no other escaping is needed. */'; echo ''; echo '#ifndef ACTA_SCHEMA_SQL_H'; echo '#define ACTA_SCHEMA_SQL_H'; echo ''; echo 'static const char ACTA_SCHEMA_SQL[] ='; awk '{ print "\"" $$0 "\\" "n\"" }' schema.sql; echo ';'; echo ''; echo '#endif /* ACTA_SCHEMA_SQL_H */'; } > include/schema_sql.h

LIB_STATIC := libacta_db.a
LIB_SHARED := libacta_db.so

# ─── Library sources ───────────────────────────────────────────────────────────
SRCS := $(wildcard $(SRC_DIR)/*.c)
OBJS := $(SRCS:$(SRC_DIR)/%.c=$(OBJ_DIR)/%.o)

# ─── Test sources ──────────────────────────────────────────────────────────────
# All test files (excluding test_common.c and test_main.c which are helpers)
TEST_SRCS := $(wildcard $(TEST_DIR)/*.c)
TEST_MAIN := $(TEST_DIR)/test_main.c


# Module list: each maps to tests/test_<module>.c with run_<module>_tests()
TEST_MODULES := db execution execution_log integration \
                model model_folder model_revision \
                skill skill_folder skill_revision \
                context_deleted execution_deleted \
                light_queries busy

.PHONY: all clean test test-build test-%

# ─── Library ───────────────────────────────────────────────────────────────────
all: $(SCHEMA_H) $(MIGRATIONS_H) $(LIB_STATIC) $(LIB_SHARED)

$(LIB_STATIC): $(OBJS)
	ar rcs $@ $^

$(LIB_SHARED): $(OBJS)
	$(CC) -shared -o $@ $^ $(LDLIBS)

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(OBJ_DIR)
	$(CC) $(CFLAGS) -I$(INC_DIR) -I$(SRC_DIR) -c $< -o $@

# ─── Run all tests (single binary) ────────────────────────────────────────────
test: $(LIB_STATIC) $(TEST_BIN_DIR)/run
	./$(TEST_BIN_DIR)/run

$(TEST_BIN_DIR)/run: $(TEST_SRCS) $(LIB_STATIC)
	@mkdir -p $(TEST_BIN_DIR)
	# -lpthread: the busy-timeout suite (tests/test_busy.c) runs the
	# contending writer on a pthread (no-op on glibc, winpthread on
	# mingw).
	$(CC) $(CFLAGS) -I$(INC_DIR) -o $@ $(TEST_SRCS) -L. -lacta_db $(LDLIBS) -lpthread

# ─── Run a single module's tests ──────────────────────────────────────────────
# Usage:
#   make test-db
#   make test-execution
#   make test-model_folder
#   make test-integration
#
# A tiny main() is generated on-the-fly so each test_<module>.c
# doesn't need to define its own main.

test-%: $(LIB_STATIC)
	@mkdir -p $(OBJ_DIR)
	@echo "#include <stdio.h>" > $(OBJ_DIR)/_gen_main_$*.c
	@echo "#include \"../tests/test_common.h\"" >> $(OBJ_DIR)/_gen_main_$*.c
	@echo "void run_$*_tests(void);" >> $(OBJ_DIR)/_gen_main_$*.c
	@echo "int main(void) {" >> $(OBJ_DIR)/_gen_main_$*.c
	@echo "    run_$*_tests();" >> $(OBJ_DIR)/_gen_main_$*.c
	@echo '    printf("\\n=== $* TESTS PASSED ===\\n");' >> $(OBJ_DIR)/_gen_main_$*.c
	@echo "    return 0;" >> $(OBJ_DIR)/_gen_main_$*.c
	@echo "}" >> $(OBJ_DIR)/_gen_main_$*.c
	$(CC) $(CFLAGS) -I$(INC_DIR) -o $(TEST_BIN_DIR)/run_$* \
		$(TEST_DIR)/test_$*.c $(OBJ_DIR)/_gen_main_$*.c \
		-L. -lacta_db $(LDLIBS)
	rm -f $(OBJ_DIR)/_gen_main_$*.c
	./$(TEST_BIN_DIR)/run_$*

# ─── Build all test binaries without running ───────────────────────────────────
test-build: $(LIB_STATIC) $(TEST_BIN_DIR)/run
	@for m in $(TEST_MODULES); do \
		mkdir -p $(OBJ_DIR); \
		echo "#include <stdio.h>" > $(OBJ_DIR)/_gen_main_$$m.c; \
		echo "#include \"../tests/test_common.h\"" >> $(OBJ_DIR)/_gen_main_$$m.c; \
		echo "void run_$$m_tests(void);" >> $(OBJ_DIR)/_gen_main_$$m.c; \
		echo "int main(void) {" >> $(OBJ_DIR)/_gen_main_$$m.c; \
		echo "    run_$$m_tests();" >> $(OBJ_DIR)/_gen_main_$$m.c; \
		echo '    printf("\\n=== $$m TESTS PASSED ===\\n");' >> $(OBJ_DIR)/_gen_main_$$m.c; \
		echo "    return 0;" >> $(OBJ_DIR)/_gen_main_$$m.c; \
		echo "}" >> $(OBJ_DIR)/_gen_main_$$m.c; \
		$(CC) $(CFLAGS) -I$(INC_DIR) -o $(TEST_BIN_DIR)/run_$$m \
			$(TEST_DIR)/test_$$m.c $(OBJ_DIR)/_gen_main_$$m.c \
			-L. -lacta_db $(LDLIBS); \
		rm -f $(OBJ_DIR)/_gen_main_$$m.c; \
		echo "  built test/run_$$m"; \
	done

# ─── Clean ─────────────────────────────────────────────────────────────────────
clean:
	rm -rf $(OBJ_DIR) $(LIB_STATIC) $(LIB_SHARED) $(TEST_BIN_DIR) $(SCHEMA_H) $(MIGRATIONS_H)
