*.db-journal
*.sqlite
*.sqlite3

# Outputs & generated artifacts
outputs/
executions/

# Local scratch: the acta_runner/MYTEST ad-hoc review workspace (its own acta.db,
# the five *_summarize review outputs, run_tests.sh) - not part of the repo.
# The pre-vocabulary copy of its acta.db is backed up under /c/msys64/tmp/actsnap/.
acta_runner/MYTEST/

# Build artifacts
*.o
*.exe
*.a
*.so

# Local build outputs (MSYS2 / Qt)
.tmp_build/
out/
build/
debug/
release/
**/Makefile
# The Makefiles that ARE repo content are listed explicitly (root-anchored: a
# pattern without a slash would match at any depth and un-ignore everything the
# rule above just ignored). The three tracked ones predate the rule, so without
# these lines any new Makefile would be silently untracked.
!/Makefile
!/acta_db/Makefile
!/acta_runner/Makefile
!/acta_cli/Makefile
Makefile.Debug
Makefile.Release
*.qmake.stash
acta_db/test/
out
acta_db_out
models.json
# The GGUF model directory the README quick start creates (`hf download --local-dir
# models/`) - multi-GB weights must never land untracked-dirty in the repo.
models/


# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs & caches
logs/
*.log
.cache/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

